require "base64"
require "cfpropertylist"
require "shellwords"
require File.expand_path(
  "deployment_configuration",
  FastlaneCore::FastlaneFolder.path
)

default_platform(:ios)

def require_environment_variables!(names)
  missing_names = names.select { |name| ENV[name].to_s.strip.empty? }
  return if missing_names.empty?

  UI.user_error!("Missing required environment variables: #{missing_names.join(', ')}")
end

def export_github_environment(name, value)
  environment_file_path = ENV["GITHUB_ENV"]
  return if environment_file_path.to_s.empty?

  File.open(environment_file_path, "a") { |file| file.puts("#{name}=#{value}") }
end

def require_semantic_version!(version)
  return if version.match?(/\A(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\z/)

  UI.user_error!("MARKETING_VERSION must follow MAJOR.MINOR.PATCH: #{version}")
end

def require_signing_identity!(team_id)
  keychain_path = Actions.lane_context[Actions::SharedValues::KEYCHAIN_PATH].to_s
  keychain_reference = if keychain_path.empty?
                         ENV["MATCH_KEYCHAIN_NAME"].to_s
                       else
                         File.expand_path(Shellwords.split(keychain_path).fetch(0))
                       end
  keychain_reference = "login.keychain" if keychain_reference.empty?
  command = "security find-identity -v -p codesigning #{Shellwords.escape(keychain_reference)}"

  identity_output = sh(command, log: false)
  return if identity_output.include?("(#{team_id})")

  UI.user_error!(
    "No valid code signing identity with a private key was installed for team #{team_id}"
  )
end

def require_expected_build_settings!(settings, expected_settings)
  mismatches = expected_settings.filter_map do |name, expected_value|
    actual_value = settings.fetch(name, nil)
    next if actual_value == expected_value

    "#{name}=#{actual_value.inspect} (expected #{expected_value.inspect})"
  end
  return if mismatches.empty?

  UI.user_error!("Unexpected distribution build settings: #{mismatches.join(', ')}")
end

def require_build_settings!(configuration)
  # build_app가 사용하는 Scheme 조회를 그대로 실행해 이번 타임아웃 회귀를 검증합니다.
  project = FastlaneCore::Project.new(
    project: DeploymentConfiguration::PROJECT,
    scheme: configuration.fetch(:scheme),
    configuration: configuration.fetch(:build_configuration),
    destination: DeploymentConfiguration::IOS_DESTINATION,
    skip_package_dependencies_resolution: true,
    disable_package_automatic_updates: true
  )
  app_expectations = {
    "TARGET_NAME" => configuration.fetch(:app_target),
    "CONFIGURATION" => configuration.fetch(:build_configuration),
    "PRODUCT_BUNDLE_IDENTIFIER" => configuration.fetch(:app_identifier),
    "DEVELOPMENT_TEAM" => DeploymentConfiguration::TEAM_ID,
    "CODE_SIGN_STYLE" => "Manual"
  }
  app_setting_names = app_expectations.keys + ["PROVISIONING_PROFILE_SPECIFIER"]
  app_settings = app_setting_names.to_h do |name|
    [name, project.build_settings(key: name, optional: false)]
  end
  require_expected_build_settings!(app_settings, app_expectations)

  # Scheme 조회에는 앱 타깃만 포함되므로 Share Extension은 타깃을 지정해 별도로 확인합니다.
  extension_target = configuration.fetch(:share_extension_target)
  command = [
    "xcodebuild",
    "-showBuildSettings",
    "-target", extension_target,
    "-project", DeploymentConfiguration::PROJECT,
    "-configuration", configuration.fetch(:build_configuration),
    "-sdk", "iphoneos",
    "-disableAutomaticPackageResolution"
  ].shelljoin + " 2>&1"
  begin
    output = FastlaneCore::Project.run_command(
      command,
      timeout: FastlaneCore::Project.xcode_build_settings_timeout,
      retries: FastlaneCore::Project.xcode_build_settings_retries,
      print: true
    )
  rescue Timeout::Error
    UI.user_error!("Share Extension build settings lookup timed out: #{extension_target}")
  end
  extension_settings = output.each_line.filter_map do |line|
    match = line.match(/\A\s*([^=]+?)\s*=\s*(.*?)\s*\z/)
    [match[1], match[2]] if match
  end.to_h
  extension_expectations = {
    "TARGET_NAME" => extension_target,
    "CONFIGURATION" => configuration.fetch(:build_configuration),
    "PRODUCT_BUNDLE_IDENTIFIER" => configuration.fetch(:share_extension_app_identifier),
    "DEVELOPMENT_TEAM" => DeploymentConfiguration::TEAM_ID,
    "CODE_SIGN_STYLE" => "Manual"
  }
  require_expected_build_settings!(extension_settings, extension_expectations)

  app_profile = app_settings.fetch("PROVISIONING_PROFILE_SPECIFIER").to_s.strip
  extension_profile = extension_settings.fetch("PROVISIONING_PROFILE_SPECIFIER", "").strip
  expected_profiles = {
    configuration.fetch(:app_identifier) => app_profile,
    configuration.fetch(:share_extension_app_identifier) => extension_profile
  }
  missing_specifiers = expected_profiles.select { |_, name| name.empty? }.keys
  unless missing_specifiers.empty?
    UI.user_error!(
      "Missing PROVISIONING_PROFILE_SPECIFIER for: #{missing_specifiers.join(', ')}"
    )
  end

  expected_profiles
end

def require_installed_provisioning_profiles!(expected_profiles)
  # Archive가 요구하는 프로파일 이름과 Match가 실제 설치한 이름을 Bundle ID별로 대조합니다.
  installed_profiles = Actions.lane_context[
    Actions::SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
  ] || {}
  mismatches = expected_profiles.filter_map do |identifier, expected_name|
    installed_name = installed_profiles[identifier]
    next if installed_name == expected_name

    "#{identifier}=#{installed_name.inspect} (expected #{expected_name.inspect})"
  end
  return if mismatches.empty?

  UI.user_error!("Provisioning profile mismatch: #{mismatches.join(', ')}")
end

def require_firebase_bundle_identifier!(configuration)
  # 환경별 Secret이 선택한 앱의 Firebase 설정인지 배포 설정의 단일 Bundle ID로 판정합니다.
  firebase_path = DeploymentConfiguration.resolve_project_path(ENV.fetch("FIREBASE_PATH"))
  unless File.file?(firebase_path) && File.readable?(firebase_path)
    UI.user_error!("Firebase plist is not readable: #{firebase_path}")
  end

  plist = CFPropertyList::List.new(file: firebase_path)
  firebase_configuration = CFPropertyList.native_types(plist.value)
  actual_identifier = firebase_configuration.fetch("BUNDLE_ID", nil)
  expected_identifier = configuration.fetch(:app_identifier)
  return if actual_identifier == expected_identifier

  UI.user_error!(
    "Firebase BUNDLE_ID=#{actual_identifier.inspect} does not match #{expected_identifier.inspect}"
  )
end

platform :ios do
  private_lane :prepare_distribution do |options|
    configuration = options.fetch(:configuration)

    # CI 전용 임시 Keychain을 사용해 Runner의 서명 자산을 격리합니다.
    setup_ci

    # App Store Connect 원격 조회와 업로드는 동일한 API Key 세트를 사용합니다.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match_git_basic_authorization = Base64.strict_encode64(
      "x-access-token:#{ENV.fetch('MATCH_GITHUB_TOKEN')}"
    )

    # 선택한 앱과 Share Extension에 필요한 App Store 서명 자산만 읽습니다.
    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: match_git_basic_authorization,
      app_identifier: [
        configuration.fetch(:app_identifier),
        configuration.fetch(:share_extension_app_identifier)
      ]
    )

    # Match can continue after `security import` rejects a PKCS#12 file. Fail here
    # so connection validation cannot report success without a usable private key.
    require_signing_identity!(DeploymentConfiguration::TEAM_ID)

    api_key
  end

  desc "Validate distribution configuration and credentials without building or uploading"
  lane :validate_deployment do
    require_environment_variables!(
      %w[
        DEPLOYMENT_TARGET
        MARKETING_VERSION
        ASC_KEY_ID
        ASC_ISSUER_ID
        ASC_KEY_CONTENT
        MATCH_GITHUB_TOKEN
        MATCH_PASSWORD
        FIREBASE_PATH
      ]
    )

    deployment_target = ENV.fetch("DEPLOYMENT_TARGET")
    marketing_version = ENV.fetch("MARKETING_VERSION")
    configuration = DeploymentConfiguration.fetch(deployment_target)

    require_semantic_version!(marketing_version)
    require_firebase_bundle_identifier!(configuration)
    expected_profiles = require_build_settings!(configuration)
    api_key = prepare_distribution(configuration: configuration)
    require_installed_provisioning_profiles!(expected_profiles)

    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: configuration.fetch(:app_identifier),
      version: marketing_version,
      initial_build_number: 0
    )

    UI.success("Distribution configuration and credential validation completed without building or uploading")
  end

  desc "Build and distribute the selected Neki app"
  lane :deploy do
    require_environment_variables!(
      %w[
        DEPLOYMENT_TARGET
        MARKETING_VERSION
        DISTRIBUTION_DESTINATION
        ASC_KEY_ID
        ASC_ISSUER_ID
        ASC_KEY_CONTENT
        MATCH_GITHUB_TOKEN
        MATCH_PASSWORD
        FIREBASE_PATH
      ]
    )

    deployment_target = ENV.fetch("DEPLOYMENT_TARGET")
    marketing_version = ENV.fetch("MARKETING_VERSION")
    distribution_destination = ENV.fetch("DISTRIBUTION_DESTINATION")
    release_notes = ENV.fetch("RELEASE_NOTES", "").strip
    configuration = DeploymentConfiguration.fetch(deployment_target)

    require_semantic_version!(marketing_version)
    require_firebase_bundle_identifier!(configuration)
    unless %w[testflight app_store_review].include?(distribution_destination)
      UI.user_error!("Unsupported distribution destination: #{distribution_destination}")
    end
    if distribution_destination == "app_store_review" && deployment_target != "production"
      UI.user_error!("Only the production app can be submitted for App Store review")
    end
    if release_notes.length > 4_000
      UI.user_error!("RELEASE_NOTES must not exceed 4,000 characters")
    end

    api_key = prepare_distribution(configuration: configuration)

    # 원격 TestFlight 상태를 기준으로 현재 버전에서 충돌하지 않는 빌드 번호를 계산합니다.
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: configuration.fetch(:app_identifier),
      version: marketing_version,
      initial_build_number: 0
    )
    build_number = latest_build + 1

    # 입력 버전과 원격 기준 빌드 번호를 모든 Target에 동일하게 주입합니다.
    # Composite Action에서 SPM을 한 번 해석했으므로 Archive에서는 그 결과만 사용합니다.
    ipa_path = build_app(
      project: DeploymentConfiguration::PROJECT,
      scheme: configuration.fetch(:scheme),
      configuration: configuration.fetch(:build_configuration),
      # 연결 검증과 gym의 Archive 전 빌드 설정 조회가 동일한 명령을 사용합니다.
      destination: DeploymentConfiguration::IOS_DESTINATION,
      export_method: "app-store",
      export_team_id: DeploymentConfiguration::TEAM_ID,
      skip_package_dependencies_resolution: true,
      disable_package_automatic_updates: true,
      xcargs: [
        "MARKETING_VERSION=#{marketing_version}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    archived_version = get_ipa_info_plist_value(
      ipa: ipa_path,
      key: "CFBundleShortVersionString"
    )
    archived_build_number = get_ipa_info_plist_value(
      ipa: ipa_path,
      key: "CFBundleVersion"
    )
    unless archived_version == marketing_version && archived_build_number == build_number.to_s
      UI.user_error!(
        "Archive version mismatch: " \
        "expected #{marketing_version}(#{build_number}), " \
        "got #{archived_version}(#{archived_build_number})"
      )
    end

    if distribution_destination == "testflight"
      # 내부 테스트에 필요한 변경사항을 TestFlight 빌드에 함께 기록합니다.
      testflight_options = {
        api_key: api_key,
        app_identifier: configuration.fetch(:app_identifier),
        ipa: ipa_path,
        distribute_external: false,
        notify_external_testers: false
      }
      testflight_options[:changelog] = release_notes unless release_notes.empty?
      upload_to_testflight(**testflight_options)
    else
      # 입력된 한국어 릴리즈 노트만 반영하고 수동 출시 방식으로 심사를 제출합니다.
      app_store_options = {
        api_key: api_key,
        app_identifier: configuration.fetch(:app_identifier),
        ipa: ipa_path,
        app_version: marketing_version,
        skip_screenshots: true,
        submit_for_review: true,
        automatic_release: false,
        run_precheck_before_submit: true,
        precheck_include_in_app_purchases: false,
        submission_information: {
          export_compliance_uses_encryption: false
        },
        force: true
      }
      app_store_options[:release_notes] = { "ko" => release_notes } unless release_notes.empty?
      upload_to_app_store(**app_store_options)
    end

    export_github_environment("APP_VERSION", marketing_version)
    export_github_environment("BUILD_NUMBER", build_number)
  end
end
