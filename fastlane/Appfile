require File.expand_path(
  "deployment_configuration",
  FastlaneCore::FastlaneFolder.path
)

# 실행 시 선택한 배포 환경의 고정 식별자를 공통 설정에서 가져옵니다.
configuration = DeploymentConfiguration.fetch(
  ENV.fetch("DEPLOYMENT_TARGET", "production")
)

app_identifier(configuration.fetch(:app_identifier))
team_id(DeploymentConfiguration::TEAM_ID)
